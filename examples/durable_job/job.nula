// Durable job checkpoint demo: run with the reference bytecode VM.
// The runner sets DEMO_PHASE=prepare or resume, and starts a new process
// against the same JSON persistence store for each phase.
persistent actor DemoJob {
    state durable stage: Int = 0
    state durable completions: Int = 0

    behavior prepare() {
        if self.stage == 0 then {
            self.stage = 1
        } else { unit }
    }

    behavior complete() {
        if self.stage == 1 then {
            self.stage = 2
            self.completions = self.completions + 1
        } else { unit }
    }

    behavior get_stage() { self.stage }
    behavior get_completions() { self.completions }
}

fn main() {
    // Preserve actor spawn order and declaration across restarts; the current
    // CLI persistence implementation uses deterministic process-local actor ids.
    let job = spawn DemoJob {}
    let mode = perform Env.get("DEMO_PHASE")
    if mode == "prepare" then {
        ask job prepare()
        let stage = ask job get_stage()
        let completions = ask job get_completions()
        perform IO.print("PREPARED=" + perform Int.to_string(stage) + ":" + perform Int.to_string(completions))
        // This FIFO has no writer. The harness SIGKILLs the process here,
        // after the actor checkpoint and acknowledgment, before completion.
        perform FS.read("gate.fifo")
    } else {
        let stage = ask job get_stage()
        let completions = ask job get_completions()
        perform IO.print("RECOVERED=" + perform Int.to_string(stage) + ":" + perform Int.to_string(completions))
        ask job complete()
        let after_stage = ask job get_stage()
        let after_completions = ask job get_completions()
        perform IO.print("COMPLETED=" + perform Int.to_string(after_stage) + ":" + perform Int.to_string(after_completions))
    }
    0
}
